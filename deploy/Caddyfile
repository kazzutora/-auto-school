{
	email {$ACME_EMAIL:oskostrycharz@poczta.onet.pl}
}

www.{$SITE_DOMAIN:oskostrycharz.pl} {
	redir https://{$SITE_DOMAIN:oskostrycharz.pl}{uri} permanent
}

{$SITE_DOMAIN:oskostrycharz.pl} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}
	reverse_proxy web:8000
}
