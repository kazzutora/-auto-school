# Copy to .env and adjust. Every value here is fake on purpose: the stack must
# come up on a clean machine without a single real secret.

# Django, tech.md section 10
DJANGO_SECRET_KEY=dev-not-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL is deliberately absent: both compose files build it from the
# POSTGRES_* values below, and a copy here would only drift out of sync.
REDIS_URL=redis://redis:6379/0
MAIL_CLIENT=fake            # fake | smtp
SMS_CLIENT=fake             # fake | smsapi
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
SMSAPI_TOKEN=
SENTRY_DSN=
IP_HASH_SALT=dev-salt
MEDIA_ROOT=/app/media

# Postgres container, and the single source of the database credentials: both
# compose files build DATABASE_URL out of these three. Change the password here
# and nowhere else.
POSTGRES_DB=osk
POSTGRES_USER=osk
POSTGRES_PASSWORD=osk

# Namespaces every volume, network and container. A second driving school runs
# from its own checkout on the same box; sharing this name would mount the same
# pgdata volume and serve one client's database to the other. tech.md 17.
COMPOSE_PROJECT_NAME=osk-ostrycharz

# Host ports, change on a collision with a local postgres or dev server. Two
# clients on one box need two of each: whichever stack comes up second cannot
# bind a port the first already holds.
POSTGRES_PORT=5433
WEB_PORT=8000

# Production only, consumed by deploy/docker-compose.prod.yml. Before the first
# deploy also replace the three development values above: DJANGO_SECRET_KEY with
# a real secret, DJANGO_DEBUG with 0, and DJANGO_ALLOWED_HOSTS with the domain.
#
# Leave WEB_IMAGE empty to build the image on the box from this checkout. The
# deploy workflow overwrites the line with the tag it just pushed to ghcr, which
# is what a machine with a registry login should use.
WEB_IMAGE=
SITE_DOMAIN=oskostrycharz.pl
ACME_EMAIL=oskostrycharz@poczta.onet.pl

# Preview on a bare ip, while the domain still points elsewhere. The two go
# together: the first serves plain http on any host name, the second stops
# django redirecting to a certificate that does not exist. Put the ip in
# DJANGO_ALLOWED_HOSTS as well. Delete both lines once the domain is live.
# CADDYFILE=Caddyfile.preview
# HTTPS_ENABLED=0
#
# Prefer a stand-in host name over the bare ip where one is available: a free
# dynamic-dns name pointed at the box earns a real certificate, so the preview
# runs over https on the same code path as the live site. It needs neither
# override above - only SITE_DOMAIN and DJANGO_ALLOWED_HOSTS set to that name,
# with ports 80 and 443 open. The www redirect keeps working because such a
# provider resolves every sub-name to the same address:
#   SITE_DOMAIN=osk-ostrycharz.duckdns.org
#   DJANGO_ALLOWED_HOSTS=osk-ostrycharz.duckdns.org
