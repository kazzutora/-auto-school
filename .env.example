# Copy to .env and adjust. Every value here is fake on purpose: the stack must
# come up on a clean machine without a single real secret.

# Django, tech.md section 10
DJANGO_SECRET_KEY=dev-not-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL is built from the POSTGRES_* values below, so the password is
# written once. Uncomment only to point at a database outside this stack, and
# then keep both in sync yourself.
# DATABASE_URL=postgres://osk:osk@db:5432/osk
REDIS_URL=redis://redis:6379/0
MAIL_CLIENT=fake            # fake | smtp
SMS_CLIENT=fake             # fake | smsapi
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
SMSAPI_TOKEN=
SENTRY_DSN=
IP_HASH_SALT=dev-salt
MEDIA_ROOT=/app/media

# Postgres container, and the single source of the database credentials: both
# compose files build DATABASE_URL out of these three.
POSTGRES_DB=osk
POSTGRES_USER=osk
POSTGRES_PASSWORD=osk

# Host ports, change on a collision with a local postgres or dev server.
POSTGRES_PORT=5432
WEB_PORT=8000

# Production only, consumed by deploy/docker-compose.prod.yml.
WEB_IMAGE=ghcr.io/OWNER/osk:latest
SITE_DOMAIN=naukajazdywielun.pl
ACME_EMAIL=osk.adam.nawrocki@wp.pl
